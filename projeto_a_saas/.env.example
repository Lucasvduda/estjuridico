# ============================================================
# LegalShield AI — Configuração (EXEMPLO)
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real!
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development
DEBUG=true

# --- Banco de dados ---
DATABASE_URL=sqlite+aiosqlite:///./legalshield_local.db

# --- Redis ---
REDIS_URL=

# --- JWT e Criptografia ---
# Gerar com: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=GERE_UMA_CHAVE_SEGURA_AQUI
# Gerar com: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=GERE_UMA_CHAVE_SEGURA_AQUI

# --- LLMs ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Limites ---
CONTRACT_CACHE_TTL_SECONDS=1800
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS_PER_MINUTE=60
MAX_FILE_SIZE_MB=25

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Admin ---
ADMIN_EMAIL=admin@seudominio.com
ADMIN_INITIAL_PASSWORD=TROQUE_ESTA_SENHA

# --- Cloudflare R2 (produção) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=legalshield-contracts
